# Supabase — cliente do navegador (`lib/supabase/client.ts`). A URL e a chave "anon" não são
# secretas por padrão no Supabase (elas dependem do RLS para segurança), mas precisam do prefixo
# NEXT_PUBLIC_ para o Next.js incluí-las no bundle do navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — cliente exclusivo do servidor (`lib/supabase/server.ts`). NUNCA prefixar com
# NEXT_PUBLIC_ e nunca importar o módulo que usa esta chave a partir de um Client Component — ela
# ignora todas as regras de RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Analytics (Fase 17, `docs/ANALYTICS.md`) — opcionais. Sem elas, a arquitetura continua pronta
# (`lib/analytics/providers/{ga4,metaPixel}.ts`), só não envia nada para esses dois provedores; o
# provider interno (Supabase, `analytics_events`) funciona independente dessas variáveis. NUNCA
# preencha com um ID inventado — só com o Measurement ID/Pixel ID reais da Upgrade, quando existirem.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# SEO (Fase SEO, `docs/SEO.md`) — domínio de produção real da Upgrade, sem barra no final
# (ex.: https://agenciaupgrade.com.br). Usado em `metadataBase`, `sitemap.xml`, `robots.txt` e nos
# dados estruturados (schema.org) para gerar URLs absolutas corretas. Sem esta variável, o site cai
# num fallback de desenvolvimento (`http://localhost:3000`) — NUNCA preencha com um domínio
# adivinhado; deixe vazio/local até o domínio real existir.
NEXT_PUBLIC_SITE_URL=
